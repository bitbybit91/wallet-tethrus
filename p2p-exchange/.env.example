# Application Settings
FLASK_ENV=production
SECRET_KEY=change-me-to-a-random-64-char-hex-string
DEBUG=false

# Database
# SQLite (development):
DATABASE_URL=sqlite:///p2p_exchange.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/p2p_exchange

# TRON Network Configuration
TRON_NETWORK=mainnet
TRONGRID_API_URL=https://api.trongrid.io
TRONGRID_API_KEY=
# Backup RPC endpoints (comma-separated)
TRON_RPC_ENDPOINTS=https://api.trongrid.io,https://api.tronstack.io
# USDT TRC20 Contract Address
USDT_CONTRACT_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# Escrow Configuration
ESCROW_TIMEOUT_HOURS=24
ESCROW_CONFIRMATION_BLOCKS=20

# Rate Limiting
RATE_LIMIT_DEFAULT=100/hour
RATE_LIMIT_TRADE=20/hour

# Notification Channels
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Nostr Relay (optional)
NOSTR_RELAY_URL=

# Session Messenger (optional)
SESSION_BOT_API_URL=

# Tor Configuration
TOR_ENABLED=false
ONION_ADDRESS=

# Logging
LOG_LEVEL=INFO
LOG_FILE=p2p_exchange.log
